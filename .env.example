# ==============================================================================
# Fraud Alert Assistant - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit or share your .env file containing real API keys or credentials.
# ==============================================================================

# 1. Groq API Key (Required for LLM tool calling)
# Get your API key from: https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"

# 2. MongoDB Database Configuration
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="bankdemo"
MONGODB_COLLECTION="fraud_alerts"

# 3. Official MongoDB MCP Server Settings
# Connection string passed to the official MCP server subprocess
MDB_MCP_CONNECTION_STRING="mongodb://127.0.0.1:27017/bankdemo"
# Enforce read-only mode for safety (true / false)
MDB_MCP_READ_ONLY="true"

# 4. Official MongoDB MCP Server Binary Path (Optional)
# Point this to your locally-built MongoDB MCP Server index.js:
# e.g., MONGODB_MCP_SERVER_PATH="~/Downloads/mongodb-mcp-server/packages/mongodb-mcp-server/dist/esm/index.js"
# If left commented or unset, the client automatically defaults to 'npx -y mongodb-mcp-server@3.1.0'
MONGODB_MCP_SERVER_PATH=""
