# ==============================================================================
# Banking Fraud Alert Assistant - Environment Configuration
# Copy this file to .env and configure values for your environment.
# NEVER commit your actual .env file containing real API keys or credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM Configuration (Required)
# ------------------------------------------------------------------------------
# Get your API key from https://console.groq.com
GROQ_API_KEY="<your_groq_api_key_here>"
# Default Groq model for reasoning and tool orchestration
GROQ_MODEL="openai/gpt-oss-120b"

# ------------------------------------------------------------------------------
# 2. MongoDB Database & Collection Scope
# ------------------------------------------------------------------------------
# MongoDB connection URI (use standard connection string format)
MONGODB_URI="mongodb://127.0.0.1:27017"
# Primary target database and collection for fraud triage
MONGODB_DATABASE="bankdemo"
MONGODB_COLLECTION="fraud_alerts"

# ------------------------------------------------------------------------------
# 3. Official MongoDB MCP Server Settings
# ------------------------------------------------------------------------------
# Connection string passed directly to the MCP Server child process
MDB_MCP_CONNECTION_STRING="mongodb://127.0.0.1:27017/bankdemo"

# Production Safety: enforce read-only access (true / false)
# Default is "true". In read-only mode, only non-mutating tools are exposed.
MDB_MCP_READ_ONLY="true"

# Path to the compiled official MongoDB MCP Server entry point (index.js).
# If left empty, the application searches standard candidate paths:
#  - ~/Downloads/mongodb-mcp-server-main/packages/mongodb-mcp-server/dist/esm/index.js
#  - ~/Documents/mongodb-mcp-server-main/packages/mongodb-mcp-server/dist/esm/index.js
#  - ./mongodb-mcp-server/packages/mongodb-mcp-server/dist/esm/index.js
MONGODB_MCP_SERVER_PATH="/path/to/mongodb-mcp-server/packages/mongodb-mcp-server/dist/esm/index.js"

# ------------------------------------------------------------------------------
# 4. Operational Boundaries & Timeouts
# ------------------------------------------------------------------------------
# Maximum documents returned by any single 'find' tool call (1 - 500)
MAX_RESULT_ROWS="50"

# Maximum wait time in seconds for MCP tool calls (stdio subprocess)
MCP_TIMEOUT_SECONDS="30"

# Maximum wait time in seconds for complete agent reasoning and response
AGENT_TIMEOUT_SECONDS="120"

# Enable verbose diagnostic logging for tool execution (true / false)
DEBUG="false"
